# Server-side configuration only. Supply secrets through the deployment secret store.
BILLING_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
BILLING_CARDSTREAM_MERCHANT_ID=
BILLING_CARDSTREAM_SIGNATURE_KEY=
BILLING_PUBLIC_API_BASE=https://api.neuralmimicry.ai
NEURALMIMICRY_SITE_BASE=https://neuralmimicry.ai

# Product objects require id, name, tokens (integer), amount_minor (integer),
# currency (GBP). amount_minor is the FINAL total including applicable tax.
# Empty catalogue deliberately disables new purchases until prices are agreed.
BILLING_PRODUCTS_JSON=[]
BILLING_TERMS_URL=
BILLING_REFUND_POLICY_URL=
BILLING_POLICY_VERSION=

# Enable only after sandbox validation and deploying atomic_cashout_v1 nmchain.
BILLING_CARDSTREAM_REFUNDS_ENABLED=0

# Set in the Customers deployment, not just in Billing:
# CUSTOMERS_REFUND_HOLD_HOURS=48
# CUSTOMERS_PASSKEY_RP_ID=neuralmimicry.ai
# CUSTOMERS_PASSKEY_ALLOWED_ORIGINS=https://neuralmimicry.ai,https://www.neuralmimicry.ai,https://api.neuralmimicry.ai
